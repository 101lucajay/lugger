# ---- Pflicht ----
# Passwort für das Dashboard (leer = kein Login – nur lokal empfohlen!)
DASHBOARD_PASSWORD=bitte-aendern

# ---- KI (Ideen, Recherche, Skripte) ----
ANTHROPIC_API_KEY=

# ---- Stimme (optional – ohne Key wird die kostenlose Edge-Stimme genutzt) ----
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# ---- Stock-Videos (kostenlos: https://www.pexels.com/api/) ----
PEXELS_API_KEY=

# ---- Upload: pro Plattform off | direct | uploadpost ----
YOUTUBE_MODE=off
TIKTOK_MODE=off
INSTAGRAM_MODE=off

# upload-post.com (ein Key für alle Plattformen)
UPLOADPOST_API_KEY=
UPLOADPOST_USER=

# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Alle Werte lassen sich auch später im Dashboard unter „Einstellungen“ ändern.
